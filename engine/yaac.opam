opam-version: "2.0"
depends: [
  "ocaml" {>= "5.0"}
  "dune" {>= "3.0" & build}
  "containers"
  "ppx_subliner"
  "zarith"
  "ppx_deriving_yojson"
  "ppx_inline_test"
  "re"
  "pringo"
  "base"
  "alcotest" {with-test}
  "odoc" {with-doc}
]
depopts: ["merlin" "utop" "ocamlformat" "ocp-indent"]
build: [
